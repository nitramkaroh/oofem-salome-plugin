{
  "boundary_conditions": [
    {
      "oofem_name": "NodalLoad",
      "display_name": "Nodal Load",
      "apply_to": "nodes",
      "params": [
        {"key": "dof", "name": "DOF", "type": "int", "default": 1, "description": "Degree of freedom (1=x, 2=y, 3=z)."},
        {"key": "val", "name": "Value", "type": "float", "default": 0.0, "description": "Load value."}
      ]
    },
    {
      "oofem_name": "Displacement",
      "display_name": "Nodal Displacement",
      "apply_to": "nodes",
      "params": [
        {"key": "dof", "name": "DOF", "type": "int", "default": 1, "description": "Degree of freedom (1=x, 2=y, 3=z)."},
        {"key": "val", "name": "Value", "type": "float", "default": 0.0, "description": "Prescribed displacement value."}
      ]
    },
    {
      "oofem_name": "SurfaceLoad",
      "display_name": "Surface Load (on Element Boundary)",
      "apply_to": "element_boundary",
      "params": [
        {"key": "dof", "name": "DOF", "type": "int", "default": 3, "description": "Direction of load (1=x, 2=y, 3=z)."},
        {"key": "val", "name": "Value", "type": "float", "default": -1000.0, "description": "Load value (e.g., pressure). Positive is tension, negative is pressure."}
      ]
    }
  ]
}